{
  "name": "EbizTray",
  "version": "1.0.0",
  "description": "EbizTray - Silent print agent with system tray, one-time origin approval, like QZ Tray but simpler",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:all": "electron-builder --win --mac --linux"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bonjour-service": "^1.2.1",
    "cors": "^2.8.5",
    "electron-store": "^8.2.0",
    "express": "^4.19.2",
    "ipp": "^2.0.1",
    "pdf-to-printer": "^5.1.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^22.13.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.EbizTray.print-agent",
    "productName": "EbizTray",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/tray-icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "print-server.js",
      "network-printers.js",
      "escpos-renderer.js",
      "html-to-escpos.js",
      "trust-manager.js",
      "tray-manager.js",
      "printers.html",
      "test-client.html",
      "test-local.html",
      "test-network.html",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/pdf-to-printer/**/*"
    ],
    "extraResources": [
      "assets/**/*"
    ]
  }
}
